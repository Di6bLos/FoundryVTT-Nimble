{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Automated Animations Configuration",
	"description": "Schema for validating animation configuration entries",
	"type": "object",
	"properties": {
		"version": {
			"type": "string",
			"description": "Configuration file version"
		},
		"melee": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/meleeEntry"
			}
		},
		"range": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/rangeEntry"
			}
		},
		"ontoken": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/ontokenEntry"
			}
		},
		"templatefx": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/genericEntry"
			}
		},
		"aura": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/genericEntry"
			}
		},
		"preset": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/genericEntry"
			}
		},
		"aefx": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/genericEntry"
			}
		}
	},
	"definitions": {
		"baseEntry": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
					"description": "UUID identifier for the entry"
				},
				"label": {
					"type": "string",
					"description": "Display name (spell or weapon name)"
				},
				"menu": {
					"type": "string",
					"description": "Menu category"
				},
				"primary": {
					"type": "object",
					"description": "Primary animation configuration"
				},
				"secondary": {
					"type": "object"
				},
				"source": {
					"type": "object"
				},
				"target": {
					"type": "object"
				},
				"macro": {
					"type": "object"
				},
				"soundOnly": {
					"type": "object"
				},
				"metaData": {
					"type": "object"
				}
			},
			"required": ["id", "label", "menu", "primary"]
		},
		"meleeEntry": {
			"allOf": [
				{ "$ref": "#/definitions/baseEntry" },
				{
					"properties": {
						"menu": { "enum": ["melee"] },
						"meleeSwitch": {
							"type": "object",
							"description": "Optional configuration for melee switch behaviour"
						}
					}
				}
			]
		},
		"rangeEntry": {
			"allOf": [
				{ "$ref": "#/definitions/baseEntry" },
				{
					"properties": {
						"menu": { "enum": ["range"] }
					}
				}
			]
		},
		"ontokenEntry": {
			"allOf": [
				{ "$ref": "#/definitions/baseEntry" },
				{
					"properties": {
						"menu": { "enum": ["ontoken"] }
					}
				}
			]
		},
		"genericEntry": {
			"$ref": "#/definitions/baseEntry"
		}
	}
}
